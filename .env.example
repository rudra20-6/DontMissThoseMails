# =====================================================================
#  DontMissThoseMails - environment variables
#  Copy to `.env` for local runs:   cp .env.example .env
#  On Render, paste these into  Dashboard -> your service -> Environment.
#  Lines marked [REQUIRED] must be filled in. Everything else has a sane default.
# =====================================================================

# ---------------------------------------------------------------- App
# Public URL of the deployed app (no trailing slash). Locally: http://localhost:8000
APP_BASE_URL=https://your-app-name.onrender.com
# [REQUIRED] Long random string protecting admin URLs. Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=change-me
# Your timezone (IANA name). All reminders / quiet hours use it.
TIMEZONE=Asia/Kolkata
# [REQUIRED for deployment] Postgres URL (Neon / Supabase free tier). Local default is a SQLite file.
DATABASE_URL=sqlite:///./dontmiss.db
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Mail source
# "graph" = Outlook / Microsoft 365 via Microsoft Graph (recommended)
# "imap"  = any IMAP mailbox (fallback, e.g. Gmail that your Outlook forwards to)
MAIL_PROVIDER=graph
MAIL_POLL_MINUTES=5
# On the very first run, look this many hours back
MAIL_LOOKBACK_HOURS=24
MAIL_MAX_PER_POLL=25

# --- Microsoft Graph (MAIL_PROVIDER=graph) --- see HOW_TO_RUN.md section 3
# [REQUIRED for graph] Application (client) ID of your Azure/Entra app registration
MS_CLIENT_ID=
# [REQUIRED for graph] Client secret *Value* (not the secret ID)
MS_CLIENT_SECRET=
# "common" works for college + personal accounts. Use "organizations" or your tenant id if needed,
# or "consumers" for a personal outlook.com/hotmail account.
MS_TENANT=common
MS_SCOPES=offline_access User.Read Mail.Read

# --- IMAP (MAIL_PROVIDER=imap) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
# For Gmail this is a 16-char App Password, not your normal password
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ---------------------------------------------------------------- WhatsApp Cloud API
# see HOW_TO_RUN.md section 4
# [REQUIRED] Permanent (System User) access token, or the 24h temporary token for testing
WHATSAPP_TOKEN=
# [REQUIRED] "Phone number ID" from WhatsApp -> API Setup (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# [REQUIRED] YOUR personal WhatsApp number, with country code, digits only (e.g. 919876543210)
WHATSAPP_RECIPIENT=
# [REQUIRED] Any string you choose; paste the same string in Meta's webhook config
WHATSAPP_VERIFY_TOKEN=change-me-verify
# Optional but recommended: App secret (App settings -> Basic). Enables webhook signature checks.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Template used to wake you up when WhatsApp's 24h window is closed. "hello_world" exists on every test number.
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
# Set true if your own template has exactly one body variable {{1}} (it receives the number of queued updates)
WHATSAPP_TEMPLATE_HAS_PARAM=false
# true = print messages to the logs instead of sending (for local testing)
WHATSAPP_DRY_RUN=false

# ---------------------------------------------------------------- Jev (all decisions)
# [REQUIRED] https://thejevai.com/settings/apikeys
JEV_API_KEY=
JEV_API_BASE_URL=https://thejevai.com
JEV_MODEL=typesafe/jev-1.13

# ---------------------------------------------------------------- Gemini (summaries + date extraction)
# [REQUIRED] https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------- Behaviour tuning
# No non-urgent messages between these local hours (they are queued and delivered after)
QUIET_HOURS_START=23
QUIET_HOURS_END=7
# Local hour of the daily digest
DIGEST_HOUR=8
# Local hour of the daily "have you registered yet?" nag for events you're interested in
EVENT_NAG_HOUR=18
# Hours before a deadline to remind you
DEADLINE_OFFSETS_HOURS=72,24,6,1
# Hours before a registered event starts
EVENT_OFFSETS_HOURS=24,2
# Hours before an event's registration closes (only for events you said you're interested in)
REGISTRATION_OFFSETS_HOURS=48,24,6,1
# Jev importance score runs 0 (ignore) .. 4 (critical)
# Mails at/above this are pushed immediately; below it (and not actionable) they go to the daily digest
IMPORTANCE_IMMEDIATE_MIN=1.5
# Mails below this (and with no deadline/event) are dropped entirely
IMPORTANCE_DROP_BELOW=0.6
# Comma-separated, case-insensitive substrings matched against the sender
IGNORE_SENDERS=
PRIORITY_SENDERS=moodle,lms,dean,registrar,academic,exam,office
# Comma-separated substrings matched against the subject; matching mails are dropped
IGNORE_SUBJECT_KEYWORDS=
